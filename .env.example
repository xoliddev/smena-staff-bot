# === Telegram ===
# Bot token from @BotFather
BOT_TOKEN=123456789:replace-me

# Comma-separated Telegram user ids of super admins (get yours from @userinfobot)
SUPERADMINS=111111111,222222222

# === White-label ===
# Restaurant / business name shown in bot messages, notifications and Excel reports.
# Defaults to "Smena" when empty.
RESTAURANT_NAME=Smena

# === PostgreSQL ===
# Either a full connection URL (takes precedence when set)...
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# ...or leave it empty and use the separate variables below (required for docker-compose).
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smena_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === Workplace geofence (initial values; admins can change them from the bot settings) ===
DEFAULT_LAT=41.311081
DEFAULT_LON=69.240562
# Allowed check-in radius in meters
DEFAULT_RADIUS=150

# Optional: Telegram group id for attendance/payment logs (the bot must be a member).
# Read by config.py; the active value is set from the bot's Settings menu.
WORK_LOG_GROUP_ID=0
